{
  "name": "rakit/validation",
  "description": "PHP Laravel like standalone validation library",
  "license": "MIT",
  "authors": [
    {
      "email": "emsifa@gmail.com",
      "name": "Muhammad Syifa"
    }
  ],
  "autoload": {
    "psr-4": {
      "Rakit\\Validation\\": "src"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Rakit\\Validation\\Tests\\": ["tests", "tests/Fixtures"]
    }
  },
  "require": {
    "php": "^8.0 || ^8.1 || ^8.2 || ^8.3 || ^8.4",
    "ext-mbstring": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.5",
    "rector/rector": "^1.2",
    "laravel/pint": "^1.22"
  },
  "config": {
    "platform": {
      "php": "8.4"
    }
  },
  "scripts": {
    "test": [
        "phpunit",
        "pint"
    ],
    "rector": "rector",
    "rector:dry-run": "rector --dry-run",
    "pint": "pint",
    "pint:test": "pint --test"
  }
}
